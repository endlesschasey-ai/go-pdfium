+bool IsLosslessIntegerToken(ByteStringView str) {
+  if (str.IsEmpty()) {
+    return false;
+  }
+  size_t position = 0;
+  bool negative = false;
+  if (str[0] == '+' || str[0] == '-') {
+    negative = str[0] == '-';
+    ++position;
+  }
+  if (position == str.GetLength()) {
+    return false;
+  }
+  const uint32_t limit =
+      static_cast<uint32_t>(std::numeric_limits<int32_t>::max()) +
+      (negative ? 1u : 0u);
+  uint32_t magnitude = 0;
+  for (; position < str.GetLength(); ++position) {
+    const auto ch = str.CharAt(position);
+    if (ch < '0' || ch > '9') {
+      return false;
+    }
+    const uint32_t digit = ch - '0';
+    if (magnitude > (limit - digit) / 10) {
+      return false;
+    }
+    magnitude = magnitude * 10 + digit;
+  }
+  return true;
+}
 

+bool CPDF_StreamAcc::LoadAllDataFilteredStrict() {
+  // An owned empty result prevents GetSpan() from exposing raw memory data
+  // after any failure. This path does not share the tolerant fallback.
+  data_ = DataVector<uint8_t>();
+  if (!stream_) {
+    return false;
+  }
+  // ISO 32000-1 Table 5 permits zero filters. Section 7.3.9 makes a
+  // null-valued optional dictionary entry equivalent to an absent entry.
+  auto filter = stream_->GetDict()->GetDirectObjectFor("Filter");
+  const auto decoders = !filter || filter->IsNull()
+                            ? std::optional<DecoderArray>(DecoderArray())
+                            : GetDecoderArray(stream_->GetDict());
+  if (!decoders.has_value()) {
+    return false;
+  }
+  DataVector<uint8_t> raw;
+  pdfium::span<const uint8_t> source;
+  if (stream_->IsMemoryBased()) {
+    source = stream_->GetInMemoryRawData();
+  } else {
+    raw = ReadRawStream();
+    source = pdfium::span(raw);
+  }
+  if (source.size() != stream_->GetRawSize()) {
+    return false;
+  }
+  if (decoders->empty()) {
+    data_ = DataVector<uint8_t>(source.begin(), source.end());
+    return true;
+  }
+  auto result = PDF_DataDecode(source, 0, false, *decoders,
+                               /*strict_decode=*/true);
+  if (!result.has_value() || !result->image_encoding.IsEmpty()) {
+    return false;
+  }
+  data_ = std::move(result->data);
+  return true;
 }
 

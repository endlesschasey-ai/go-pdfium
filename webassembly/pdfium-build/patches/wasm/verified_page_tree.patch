+bool HasValidA85End(pdfium::span<const uint8_t> source) {
+  uint32_t digits = 0;
+  uint64_t value = 0;
+  for (size_t i = 0; i < source.size(); ++i) {
+    const uint8_t ch = source[i];
+    if (IsMetadataWhitespace(ch)) {
+      continue;
+    }
+    if (ch == '~') {
+      if (i + 1 >= source.size() || source[i + 1] != '>' || digits == 1) {
+        return false;
+      }
+      if (digits) {
+        for (; digits < 5; ++digits) {
+          value = value * 85 + 84;
+        }
+      }

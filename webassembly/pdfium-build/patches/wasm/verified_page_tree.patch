+bool CPDF_Document::ValidateOriginalPageTree() {
+  // Retaining dictionaries preserves identity when legacy traversal promotes a
+  // direct child into the document's indirect-object table.
+  struct Frame {
+    RetainPtr<const CPDF_Dictionary> dict;
+    RetainPtr<const CPDF_Array> kids;
+    size_t next = 0;
+    uint32_t leaves = 0;
+    std::optional<uint32_t> declared_count;
+  };
+  struct Inference {
+    RetainPtr<const CPDF_Dictionary> dict;
+    bool branch;
+  };
+  std::vector<Frame> stack;
+  std::vector<Inference> inferred;
+  std::vector<std::pair<RetainPtr<const CPDF_Dictionary>, uint32_t>> missing_counts;
+  std::set<const CPDF_Dictionary*> active;
+  std::set<const CPDF_Dictionary*> visited;
+  auto visit = [&]() {
+    if (verified_result_.visits >= verified_max_visits_) {
+      return FailVerification(8);
+    }
+    ++verified_result_.visits;
+    return true;
+  };
+  auto resolve = [&](RetainPtr<const CPDF_Object> object) {
+    std::set<uint32_t> references;
+    while (object && object->IsReference()) {
+      if (!visit()) {
+        return RetainPtr<const CPDF_Object>();
+      }
+      uint32_t number = object->AsReference()->GetRefObjNum();
+      if (!references.insert(number).second) {
+        FailVerification(5);
+        return RetainPtr<const CPDF_Object>();
+      }
+      object = GetOrParseIndirectObject(number);
+      if (parser_->HasStrictObjectDecodeFailure()) {
+        FailVerification(10);
+        return RetainPtr<const CPDF_Object>();
+      }
+    }
+    return object;
+  };
+  auto push = [&](RetainPtr<const CPDF_Object> object, bool root) {
+    if (stack.size() >= verified_max_depth_) {
+      return FailVerification(7);
+    }
+    if (!visit()) {
+      return false;
+    }
+    object = resolve(std::move(object));
+    if (!object || !object->IsDictionary()) {
+      return FailVerification(root ? 1 : 2);
+    }
+    RetainPtr<const CPDF_Dictionary> dict(object->AsDictionary());
+    if (active.contains(dict.Get())) {
+      return FailVerification(5);
+    }
+    if (!visited.insert(dict.Get()).second) {
+      return FailVerification(6);
+    }
+    bool branch = dict->KeyExist("Kids");
+    auto type = resolve(dict->GetObjectFor("Type"));
+    if (verified_terminal_failure_) {
+      return false;
+    }
+    ByteString name = type && type->IsName() ? type->GetString() : ByteString();
+    if ((name == "Page" && branch) || (name == "Pages" && !branch) ||
+        (root && !branch)) {
+      return FailVerification(2);
+    }
+    if (name != "Page" && name != "Pages") {
+      inferred.push_back({dict, branch});
+    }
+    Frame frame;
+    frame.dict = dict;
+    if (branch) {
+      auto kids = resolve(dict->GetObjectFor("Kids"));
+      if (!kids || !kids->IsArray()) {
+        return FailVerification(2);
+      }
+      frame.kids = RetainPtr<const CPDF_Array>(kids->AsArray());
+    }
+    if (branch && dict->KeyExist("Count")) {
+      auto count = resolve(dict->GetObjectFor("Count"));
+      if (!count || !count->IsNumber() || !count->AsNumber()->IsInteger() ||
+          !count->AsNumber()->IsLosslessInteger() || count->GetInteger() < 0) {
+        return FailVerification(3);
+      }
+      frame.declared_count = static_cast<uint32_t>(count->GetInteger());
+    }
+    if (!branch) {
+      if (verified_leaves_.size() >= verified_max_pages_) {
+        return FailVerification(9);
+      }
+      verified_leaves_.push_back(dict);
+      frame.leaves = 1;
+    }
+    active.insert(dict.Get());
+    stack.push_back(std::move(frame));
+    return true;
+  };
+  if (!push(root_dict_->GetObjectFor("Pages"), true)) {
+    return false;
+  }
+  while (!stack.empty()) {
+    Frame& frame = stack.back();
+    if (frame.kids && frame.next < frame.kids->size()) {
+      auto child = frame.kids->GetObjectAt(frame.next++);
+      if (!push(std::move(child), false)) {
+        return false;
+      }
+      continue;
+    }
+    if (frame.declared_count && *frame.declared_count != frame.leaves) {
+      return FailVerification(4);
+    }
+    if (frame.kids && !frame.declared_count) {
+      missing_counts.emplace_back(frame.dict, frame.leaves);
+    }
+    uint32_t leaves = frame.leaves;
+    active.erase(frame.dict.Get());
+    stack.pop_back();
+    if (!stack.empty()) {
+      if (leaves > verified_max_pages_ - stack.back().leaves) {
+        return FailVerification(9);
+      }
+      stack.back().leaves += leaves;
+    }
+  }
+  if (parser_->HasStrictObjectDecodeFailure()) {
+    return FailVerification(10);
+  }
+  // Only mutate after all original Count and graph checks passed.
+  for (const auto& entry : inferred) {
+    const_cast<CPDF_Dictionary*>(entry.dict.Get())->SetNewFor<CPDF_Name>(
+        "Type", entry.branch ? "Pages" : "Page");
+    ++verified_result_.recoveries;
+  }
+  for (const auto& [dict, count] : missing_counts) {
+    const_cast<CPDF_Dictionary*>(dict.Get())->SetNewFor<CPDF_Number>(
+        "Count", static_cast<int>(count));
+    ++verified_result_.recoveries;
+  }
+  verified_result_.page_count = static_cast<uint32_t>(verified_leaves_.size());
+  verified_tree_valid_ = true;
+  return true;
+}
+
+bool CPDF_Document::CheckVerifiedPageMapping() {
+  if (GetPageCount() < 0 ||
+      static_cast<size_t>(GetPageCount()) != verified_leaves_.size()) {
+    return FailVerification(11);
+  }
+  for (size_t i = 0; i < verified_leaves_.size(); ++i) {
+    if (GetPageDictionary(static_cast<int>(i)).Get() != verified_leaves_[i].Get()) {
+      return FailVerification(11);
+    }
+    if (parser_->HasStrictObjectDecodeFailure()) {
+      return FailVerification(10);
+    }
+  }
+  verified_result_.status = 0;
+  return true;
+}
+
+bool CPDF_Document::FinalizeVerifiedLoad() {
+  if (parser_ && parser_->HasStrictObjectDecodeFailure()) {
+    return FailVerification(10);
+  }
+  if (verified_terminal_failure_) {
+    return false;
+  }
+  if (!root_dict_) {
+    return FailVerification(1);
+  }
+  return verified_tree_valid_ && CheckVerifiedPageMapping();
+}

+// WASM extension ABI. All limits must be positive. Status: 0 success, 1 root,
+// 2 node/type, 3 Count type, 4 Count mismatch, 5 cycle, 6 duplicate,
+// 7 depth, 8 visits, 9 leaves, 10 object decode, 11 mapping, 12 parse.
+// A failed open never returns a document. This validates the page tree and
+// dependent object streams, not page content streams or complete PDF syntax.
+typedef struct {
+  uint32_t status;
+  uint32_t page_count;
+  uint32_t visits;
+  uint32_t recoveries;
+} FPDF_VERIFIED_RESULT;
+FPDF_EXPORT FPDF_DOCUMENT FPDF_CALLCONV FPDF_LoadCustomDocumentVerified(
+    FPDF_FILEACCESS* file_access, FPDF_BYTESTRING password,
+    uint32_t max_depth, uint32_t max_visits, uint32_t max_pages,
+    FPDF_VERIFIED_RESULT* result);
+#ifdef __cplusplus
+}
+#endif
